# Copy to .env for local development. Never commit .env.

# Postgres. The app connects as the RLS-restricted role; migrations run as the owner.
DATABASE_URL=postgres://ebike_app:ebike_app@localhost:5432/ebike
DATABASE_URL_OWNER=postgres://ebike:ebike@localhost:5432/ebike

# Job queue (pg-boss). Defaults to DATABASE_URL_OWNER; pg-boss only touches the `pgboss` schema.
# QUEUE_DATABASE_URL=

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
# Hours of inactivity before a user is signed out (NFR-05).
SESSION_IDLE_HOURS=12

# SMS / OTP via MSG91 (DLT template). Leave empty in development: OTPs are printed by the worker.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
